# Copy this file to ".env" in the project root (same folder as composer.json).
# Never commit .env — it is listed in .gitignore.

# MongoDB Atlas (replace YOUR_USER / YOUR_PASSWORD / host with Atlas "Connect" string)
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=mt_auth

# Optional: custom CA bundle path (otherwise php/certs/cacert.pem + openssl.cafile are used)
# MONGO_TLS_CAFILE=C:\path\to\cacert.pem

# Set to 1 to skip tlsDisableOCSPEndpointCheck (stricter TLS; may fail on some Windows setups)
# MONGO_TLS_STRICT=1
